# 复制为 .env.local 后填写。不要提交真实密钥。
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# WorkBuddy 等兼容服务可使用这个入口，填写其底层服务 URL、Key 和模型名。
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
SIYU_HOST=127.0.0.1
SIYU_PORT=8787
# SIYU_DATABASE=data/siyu.db

# 云端预览使用 Neon Postgres；本地留空时继续使用 SQLite。
DATABASE_URL=

# 可选：设置后，除健康检查外的 API 都需要设备本地输入同一口令。
SIYU_PRIVATE_ACCESS_TOKEN=
